{
  "name": "shopkart-server",
  "version": "1.0.0",
  "description": "ShopKart Express API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --forceExit",
    "db:setup": "node scripts/setupDatabase.js",
    "db:migrate": "node scripts/migrateWishlistPayment.js",
    "db:migrate:profile": "node scripts/migrateProfile.js",
    "db:migrate:payments": "node scripts/migrateRazorpayReviews.js",
    "db:seed-products": "node scripts/seedProducts.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
